# ─── MistriJi Auth API Environment ─────────────────────────
# Copy this file to .env and fill in your credentials

# ─── Nodemailer (Gmail SMTP) ───────────────────────────────
# Use a Gmail App Password, NOT your regular password
# To create one: Google Account → Security → 2-Step Verification → App Passwords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ─── Fast2SMS (Phone OTP) ─────────────────────────────────
# Get your API key from https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ─── Supabase (shared with frontend) ──────────────────────
SUPABASE_URL=https://ptvfidufwlswbjgsjvzl.supabase.co
SUPABASE_KEY=sb_publishable_kckNPRr3_XKHhGhjS3Jccw_jl7z8XSs

# ─── Server ───────────────────────────────────────────────
PORT=3002

# ─── Razorpay Payments ────────────────────────────────────
# Get your API keys from the Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
